  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 022f4bbeb19dcf7d6a436a10daddf33d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingSequence
  scriptTitle: THE STAR OF TLAXCALA
  scriptBody: 'SCENE 1. A small town in Tlaxcala. Morning.


    A young woman walks
    to the plaza. She has an old camera.


    WOMAN: Today is a special day.


    She
    opens a small box. Inside, there is a golden necklace with a star.


    WOMAN:
    This star is my secret. Nobody knows it.'
  starName: ELENA
  enedinaLines:
  - Wait... Elena? That famous actress from Tlaxcala?
  - I wonder why her name is here.
  - Could this be one of her movies? There must be a story behind this.
  secretText: A SECRET THAT THE FAMILY HAS KEPT HIDDEN FOR YEARS IS ABOUT TO COME
    TO LIGHT...
  nextScene: Resultados
